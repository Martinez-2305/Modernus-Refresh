# ===========================================================================
#  Modernus Decoration Projects LTD — Hostinger (.htaccess)
#  HTTPS + non-www canonicalisation, clean home URL, caching, security
# ===========================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# ---------------------------------------------------------------------------
#  1. Canonical host: force HTTPS and strip www  ->  https://modernus...co.uk
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + remove www in a single 301
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://modernusdecorationprojects.co.uk%{REQUEST_URI} [R=301,L]

  # Redirect any request for index.html to the directory root ( / )
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
#  2. Custom error page
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
#  3. Compression (gzip / brotli)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/ld+json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript \
    application/json application/ld+json image/svg+xml application/xml
</IfModule>

# ---------------------------------------------------------------------------
#  4. Browser caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/avif               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml          "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived, immutable caching for static assets
  <FilesMatch "\.(css|js|avif|webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate HTML
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---------------------------------------------------------------------------
  #  5. Security headers
  # ---------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ---------------------------------------------------------------------------
#  6. Correct MIME types (in case the server is missing them)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif                  .avif
  AddType image/webp                  .webp
  AddType application/manifest+json   .webmanifest
  AddType application/ld+json         .jsonld
</IfModule>
